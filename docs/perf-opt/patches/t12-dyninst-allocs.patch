   protected:
     /** The result of the instruction; assumes an instruction can have many
-     *  destination registers.
+     *  destination registers. Only filled when results are recorded for
+     *  a checker CPU. Backed by a list, which unlike the default deque
+     *  allocates nothing while it stays empty.
      */
-    std::queue<InstResult> instResult;
+    std::queue<InstResult, std::list<InstResult>> instResult;
 
     /** PC state for this instruction. */
     std::unique_ptr<PCStateBase> pc;
@@ -854,6 +856,20 @@ class DynInst : public ExecContext, public RefCounted
         return *next_pc != *predPC;
     }
 
+    /**
+     * Same as mispredicted(), computing the next PC in a caller-owned
+     * scratch PC instead of a fresh heap clone. The scratch must only
+     * ever hold PCs of this CPU's ISA; set() then copies every field of
+     * the PC into it, so the result is the same as with a clone.
+     */
+    bool
+    mispredicted(std::unique_ptr<PCStateBase> &scratch) const
+    {
+        set(scratch, *pc);
+        staticInst->advancePC(*scratch);
+        return *scratch != *predPC;
+    }
+
     //
     //  Instruction types.  Forward checks to StaticInst object.
     //
